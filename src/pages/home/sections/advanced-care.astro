---
import { ADVANCED_CARE_CONTENT } from '../../../data/advanced-care-data';
import { AdvancedCareIcon } from '../../../components/ui/AdvancedCareIcon';
---

<section id="advanced-surgical-care" class="advanced-care-section" aria-labelledby="advanced-care-title">
  <div class="header-container">
    <header class="header-group">
      <h3 id="advanced-care-title" class="subsection-title">{ADVANCED_CARE_CONTENT.subtitle}</h3>
      <div class="title-underline"></div>
      <p class="subsection-intro">{ADVANCED_CARE_CONTENT.title}</p>
    </header>
  </div>

  <div class="care-grid-container">
    <div class="care-grid">
      {ADVANCED_CARE_CONTENT.items.map((item) => (
        <article class="care-item">
          <div class="care-circle">
            <AdvancedCareIcon name={item.iconName} size={44} className="circle-icon" />
          </div>
          <div class="content-box">
            <h4 class="care-title">{item.title}</h4>
            <div class="card-accent" aria-hidden="true"></div>
            <p class="care-description">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  :root {
    --color-bg-cream: #f9f7f0;
    --color-text-green: #0a441e;
    --color-text-gold: #bb9313;
    --color-text-body: #333333;
    --transition-elegant: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .advanced-care-section {
    background-color: var(--color-text-green);
    padding: 0;
    font-family: 'Montserrat', sans-serif;
  }

  .header-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 0;
    border-top: 1px solid rgba(187, 147, 19, 0.45);
  }

  .header-group {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .subsection-title {
    font-family: 'Calistoga', serif;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: #ffffff;
    margin: 0;
    font-weight: 400;
  }

  .subsection-intro {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-gold);
    max-width: 640px;
    margin: 1.25rem auto 0;
    text-align: center;
  }

  .title-underline {
    width: 40px;
    height: 2px;
    background: var(--color-text-gold);
    margin: 1rem auto 0;
  }

  .care-grid-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }

  .care-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .care-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1.5rem;
    gap: 1.5rem;
    background: #ffffff;
    border: 1px solid rgba(187, 147, 19, 0.12);
    border-radius: 22px;
    box-shadow: 0 10px 40px -15px rgba(10, 68, 30, 0.1);
    transition: var(--transition-elegant);
  }

  .care-item:hover {
    border-color: var(--color-text-gold);
    box-shadow: 0 16px 46px -18px rgba(10, 68, 30, 0.18);
    transform: translateY(-4px);
  }

  .care-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--color-bg-cream);
    border: 2px solid rgba(187, 147, 19, 0.2);
    flex-shrink: 0;
    transition: var(--transition-elegant);
  }

  .care-item:hover .care-circle {
    border-color: var(--color-text-gold);
    background: #ffffff;
  }

  .circle-icon {
    color: var(--color-text-gold);
    transition: var(--transition-elegant);
  }

  .care-item:hover .circle-icon {
    color: var(--color-text-green);
    transform: scale(1.08);
  }

  .content-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .care-title {
    font-family: 'Calistoga', serif;
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--color-text-green);
    margin: 0;
    line-height: 1.3;
    text-wrap: balance;
  }

  .card-accent {
    width: 30px;
    height: 1px;
    background: var(--color-text-gold);
  }

  .care-description {
    color: var(--color-text-body);
    line-height: 1.65;
    margin: 0;
    font-size: 0.95rem;
  }

  @media (max-width: 1024px) {
    .care-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .header-container {
      padding: 1.5rem 1rem 0;
    }

    .care-grid-container {
      padding: 0 1rem 2.5rem;
    }

    .care-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .care-item {
      padding: 1.75rem 1.25rem;
    }
  }
</style>
