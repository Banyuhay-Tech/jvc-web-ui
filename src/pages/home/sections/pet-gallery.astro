---
import { GALLERY_CONTENT } from '../../../data/pet-gallery-data';
const images = GALLERY_CONTENT.images;
---

<section class="pet-gallery-section" aria-labelledby="pet-gallery-title">
  <div class="container">
    <div class="content-wrapper">
      <div class="image-column">
        <div class="carousel-wrapper">
          <div class="image-wrapper">
            <div class="carousel-track" role="region" aria-label="Patient recovery gallery">
              <div class="carousel-inner" id="gallery-track">
                {images.map((image) => (
                  <div class="gallery-slide">
                    <img
                      src={image.src}
                      alt={image.alt}
                      class="gallery-image"
                      loading="lazy"
                      width="550"
                      height="413"
                    />
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="carousel-dots" id="gallery-dots" role="tablist" aria-label="Gallery slides">
            {images.map((_, i) => (
              <button
                type="button"
                class={`dot ${i === 0 ? 'active' : ''}`}
                data-index={i}
                role="tab"
                aria-label={`Go to slide ${i + 1}`}
                aria-selected={i === 0}
              />
            ))}
          </div>
        </div>
      </div>

      <div class="text-column">
        <div class="icon-wrapper" set:html={GALLERY_CONTENT.icon} aria-hidden="true" />
        <h2 id="pet-gallery-title" class="section-title">{GALLERY_CONTENT.title}</h2>
        <p class="section-description">{GALLERY_CONTENT.description}</p>
      </div>
    </div>
  </div>
</section>

<style>
  :root {
    --color-bg-cream: #ede4c5;
    --color-text-green: #0a441e;
    --color-gold-dots: #bb9313;
    --transition-elegant: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pet-gallery-section {
    background-color: var(--color-bg-cream);
    padding: 6rem 1.5rem 2rem;
    font-family: 'Montserrat', sans-serif;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .content-wrapper {
    display: flex;
    flex-direction: column-reverse;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 800px) {
    .content-wrapper {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 4rem;
    }
  }

  .image-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 550px;
  }

  .carousel-wrapper {
    width: 100%;
  }

  .image-wrapper {
    width: 100%;
    border-radius: 24px;
    overflow: hidden;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  }

  .carousel-track {
    overflow: hidden;
    width: 100%;
  }

  .carousel-inner {
    display: flex;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-slide {
    flex: 0 0 100%;
    min-width: 100%;
  }

  .gallery-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 4/3;
    object-fit: cover;
  }

  .carousel-dots {
    display: flex;
    gap: 10px;
    justify-content: center;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: none;
    background-color: var(--color-gold-dots);
    opacity: 0.5;
    cursor: pointer;
    transition: var(--transition-elegant);
    padding: 0;
  }

  .dot.active,
  .dot[aria-selected="true"] {
    opacity: 1;
    transform: scale(1.15);
  }

  .text-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 480px;
    gap: 1rem;
  }

  .icon-wrapper {
    width: 72px;
    height: 72px;
    color: var(--color-text-green);
    transform: rotate(5deg);
  }

  .icon-wrapper :global(svg) {
    width: 100%;
    height: 100%;
  }

  .section-title {
    font-family: 'Calistoga', serif;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 400;
    color: var(--color-text-green);
    margin: 0;
    line-height: 1.2;
    text-align: center;
    text-wrap: balance;
  }

  .section-description {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-green);
    margin: 0;
    text-align: center;
  }

  @media (max-width: 799px) {
    .pet-gallery-section {
      padding: 4rem 1rem 1.5rem;
    }

    .content-wrapper {
      gap: 2.5rem;
    }

    .icon-wrapper {
      width: 60px;
      height: 60px;
    }
  }
</style>

<script>
  const inner = document.getElementById('gallery-track');
  const slides = document.querySelectorAll('#gallery-track .gallery-slide');
  const dots = document.querySelectorAll('#gallery-dots .dot');

  if (inner instanceof HTMLElement && slides.length > 0) {
    const count = slides.length;
    let current = 0;
    let autoTimer: ReturnType<typeof setInterval> | null = null;

    function goTo(index: number) {
      current = ((index % count) + count) % count;
      inner.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((dot, i) => {
        if (!(dot instanceof HTMLElement)) return;
        dot.classList.toggle('active', i === current);
        dot.setAttribute('aria-selected', i === current ? 'true' : 'false');
      });
    }

    function next() {
      goTo(current + 1);
    }

    function startAuto() {
      if (autoTimer) return;
      autoTimer = setInterval(() => {
        if (!document.hidden) next();
      }, 4000);
    }

    function stopAuto() {
      if (!autoTimer) return;
      clearInterval(autoTimer);
      autoTimer = null;
    }

    dots.forEach((dot) => {
      if (!(dot instanceof HTMLElement)) return;
      dot.addEventListener('click', () => {
        stopAuto();
        goTo(Number(dot.dataset.index ?? 0));
        startAuto();
      });
    });

    const wrapper = document.querySelector('.carousel-wrapper');
    if (wrapper instanceof HTMLElement) {
      wrapper.addEventListener('mouseenter', stopAuto);
      wrapper.addEventListener('mouseleave', startAuto);
    }

    let touchStartX = 0;
    inner.addEventListener('touchstart', (e) => {
      const t = (e as TouchEvent).touches[0];
      if (t) touchStartX = t.clientX;
    }, { passive: true });

    inner.addEventListener('touchend', (e) => {
      const t = (e as TouchEvent).changedTouches[0];
      if (!t) return;
      const diff = touchStartX - t.clientX;
      if (Math.abs(diff) > 40) {
        stopAuto();
        goTo(diff > 0 ? current + 1 : current - 1);
        startAuto();
      }
    }, { passive: true });

    goTo(0);
    startAuto();
  }
</script>
