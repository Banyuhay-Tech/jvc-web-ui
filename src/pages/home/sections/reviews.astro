---
import { WORKER_URL } from "astro:env/server";
import { REVIEWS_CONTENT } from "../../../data/reviews-content";
import { fetchReviews } from "../../../lib/fetch-reviews";
import ReviewHighlight from "../../../components/reviews/ReviewHighlight.astro";
import ReviewCard from "../../../components/reviews/ReviewCard.astro";
import type { HighlightRating, Review } from "../../../types/review.type";

const reviewsData = await fetchReviews(WORKER_URL || undefined);

const formatReviewDate = (isoDate: string): string => {
  const date = new Date(isoDate);
  if (Number.isNaN(date.getTime())) return "";
  const month = date.toLocaleDateString("en-US", { month: "long" });
  return `${month} ${date.getDate()}`;
};

const googleAvg = reviewsData.sources.google.avg;
const reviewCount = reviewsData.sources.google.totalCount;
const reviewCountLabel =
  reviewCount >= 1000
    ? `${Math.floor(reviewCount / 1000)}000+`
    : reviewCount > 0
      ? `${reviewCount}+`
      : "—";

const highlights: HighlightRating[] = [
  {
    value: REVIEWS_CONTENT.facebookRecommend,
    label: REVIEWS_CONTENT.recommendedLabel,
    type: "text",
    source: "facebook",
  },
  {
    value: googleAvg > 0 ? googleAvg.toFixed(1) : "—",
    points: googleAvg > 0 ? googleAvg : undefined,
    type: "stars",
    source: "google",
  },
  {
    value: reviewCountLabel,
    label: REVIEWS_CONTENT.reviewsLabel,
    type: "text",
  },
  {
    value: `${REVIEWS_CONTENT.facebookReviewsCount}+`,
    label: "FB reviews",
    type: "text",
    source: "facebook",
  },
  {
    value: REVIEWS_CONTENT.likesCount,
    label: REVIEWS_CONTENT.likesLabel,
    type: "text",
  },
];

const reviewsDisplay: Review[] = reviewsData.reviews
  .map((review) => ({
    id: review.id,
    name: review.author,
    review: review.text,
    avatar: review.avatar,
    rating: review.rating,
    date: formatReviewDate(review.date),
    url: review.profileUrl,
    source: review.source,
  }))
  .filter((review) => !!review.review)
  .slice(0, 8);
---

<section class="reviews-section" id="reviews" aria-labelledby="reviews-title">
  <div class="container">
    <header class="reviews-header">
      <h2 id="reviews-title" class="section-title">{REVIEWS_CONTENT.title}</h2>
      <p class="section-description">{REVIEWS_CONTENT.description}</p>
    </header>

    <div class="stats-bar">
      {highlights.map((highlight) => (
        <ReviewHighlight highlight={highlight} />
      ))}
    </div>

    <div class="cards-grid">
      {reviewsDisplay.map((review) => (
        <ReviewCard review={review} />
      ))}
    </div>

    <div class="cta-row">
      <a
        class="btn btn-primary"
        href={REVIEWS_CONTENT.cta.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {REVIEWS_CONTENT.cta.text}
      </a>
      <a
        class="btn btn-outline"
        href={REVIEWS_CONTENT.ctaSecondary.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {REVIEWS_CONTENT.ctaSecondary.text}
      </a>
    </div>
  </div>
</section>

<style>
  .reviews-section {
    background: #ffffff;
    padding: clamp(3.5rem, 7vw, 5.5rem) 1.25rem;
    font-family: "Montserrat", sans-serif;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .reviews-header {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .section-title {
    margin: 0;
    font-family: "Calistoga", serif;
    font-size: clamp(1.85rem, 4.5vw, 2.75rem);
    color: #0a441e;
    line-height: 1.15;
  }

  .section-description {
    margin: 0;
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    color: #666;
    line-height: 1.55;
  }

  .stats-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem 2rem;
    background: #f3f3f3;
    border-radius: 1.5rem;
    padding: 1.5rem 1.25rem;
  }

  @media (min-width: 900px) {
    .stats-bar {
      justify-content: space-between;
      padding: 2rem 3rem;
    }
  }

  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.6rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease,
      border-color 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-primary {
    background: #0a441e;
    color: #fff;
    border: 2px solid #0a441e;
  }

  .btn-primary:hover {
    background: #bb9313;
    border-color: #bb9313;
  }

  .btn-outline {
    background: #fff;
    color: #0a441e;
    border: 2px solid #0a441e;
  }

  .btn-outline:hover {
    background: #ede4c5;
  }
</style>
