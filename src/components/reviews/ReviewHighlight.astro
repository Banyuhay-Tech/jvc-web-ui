---
import type { HighlightRating } from "../../types/review.type";
import StarScore from "./StarScore.astro";

interface Props {
  highlight: HighlightRating;
}

const { highlight } = Astro.props;
const showSourceIcon = !!highlight.source;
---

<div class="review-highlight">
  <p class="highlight-value">{highlight.value}</p>

  {(highlight.type === "stars" || showSourceIcon) && (
    <div class="highlight-meta">
      {highlight.source === "facebook" && (
        <img src="/images/brand-facebook.svg" alt="" width="16" height="16" loading="lazy" />
      )}
      {highlight.source === "google" && (
        <img src="/images/brand-google.svg" alt="" width="17" height="17" loading="lazy" />
      )}
      {highlight.type === "stars" && highlight.points != null && (
        <StarScore score={highlight.points} />
      )}
    </div>
  )}

  {highlight.label && <p class="highlight-label">{highlight.label}</p>}
</div>

<style>
  .review-highlight {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 5.5rem;
    gap: 0.25rem;
  }

  .highlight-value {
    margin: 0;
    font-family: "Montserrat", sans-serif;
    font-weight: 800;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: #0a441e;
    line-height: 1.1;
  }

  .highlight-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .highlight-label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: #666;
    text-align: center;
  }
</style>
